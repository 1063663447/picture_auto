# 复制为 .env 后填入真实 Key；config.json 里的 api_key_env 指向这些变量名。
# 工作台启动时会自动读取本文件，不需要装 python-dotenv。文件必须是 UTF-8。

# 65535 网关（gpt-image-2 / nano-banana 等）
# 注意：图片接口走 sub-proxy-us.65535.space，api2.65535.space 对图片分组会 403
TERRA_API_KEY=

# harness 用的对话模型（支持看图的 deepseek-flash）
DEEPSEEK_API_KEY=

# 飞书多维表格（记录库）—— 配置步骤见 deploy/feishu.md
# app_id / app_secret 在 https://open.feishu.cn/app 的「凭证与基础信息」里
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Cloudflare（可选：公网隧道部署用，见 deploy/cloudflare.md）
CLOUDFLARE_API_TOKEN=

# OpenAI 官方 / 其它兼容中转站（一本通：one-api、new-api、云雾、302.ai、硅基流动…）
OPENAI_API_KEY=
# 若中转站不是官方域名，请同时改 config.json -> providers.gateway.base_url

# 火山方舟（Seedream / SeedEdit）
ARK_API_KEY=

# Google Gemini 图片编辑
GEMINI_API_KEY=

# 自定义 JSON 接口
CUSTOM_API_KEY=
