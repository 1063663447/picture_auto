# 仓库根 .gitignore（整个 picture_auto）
workbench/.env
workbench/.env.*
!workbench/.env.example
workbench/data/
workbench/.bin/
workbench/docs/
workbench/.skills/
workbench/deploy/*.zip
.tmp-uiux/

__pycache__/
*.pyc
*.log
.DS_Store
Thumbs.db
# 构建资产（embed python + wheel，共 23MB，可从旧包重新提取：tools/extract_portable_assets.py）
scratch/
# 便携包 staging（每次 130MB+，成品放 workbench/releases/ 且那里也已忽略）
dist/
# 提示词生成器的覆盖备份（--force 时产生）
workbench/library/prompts/*.json.bak
